{
  "name": "@pda/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard centrado en la spec (Vite+React + server delgado).",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.ts\" \"vite\"",
    "server": "node server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pda/orchestrator": "workspace:*",
    "@pda/spec": "workspace:*",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
